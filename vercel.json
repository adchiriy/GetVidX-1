{
  "framework": "vite",
  "buildCommand": "node scripts/prepare-vercel.mjs && npm run build",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{.vercel-server/**,.vercel-bin/**,node_modules/ffmpeg-static/ffmpeg}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?endpoint=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
